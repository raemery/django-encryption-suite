#: .\admin.py:322
#, python-format
msgid ""
"Cannot schedule %(n)d key(s) (%(reasons)s). Destroying one makes its silo's "
"data permanently unreadable, and deleting would refuse it for the same "
"reason. Delete the silo first, or set "
"KEY_DELETION_CAN_RENDER_DATA_INACCESSIBLE to True in ENCRYPTION. %(uids)s"
msgstr ""
"Impossibile pianificare %(n)d chiave/i (%(reasons)s). Distruggerne una rende "
"i dati del suo silo permanentemente illeggibili, e l’eliminazione la "
"rifiuterebbe per lo stesso motivo. Elimina prima il silo, oppure imposta "
"KEY_DELETION_CAN_RENDER_DATA_INACCESSIBLE su True in ENCRYPTION. %(uids)s"

