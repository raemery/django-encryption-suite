#: .\lifecycle.py:287
msgid "shared or operator-supplied key"
msgstr "ਸਾਂਝੀ ਜਾਂ ਆਪਰੇਟਰ ਵੱਲੋਂ ਦਿੱਤੀ ਕੁੰਜੀ"

#: .\lifecycle.py:292
msgid "key deletion is not enabled for this provisioner"
msgstr "ਇਸ ਪ੍ਰੋਵਿਜ਼ਨਰ ਲਈ ਕੁੰਜੀ ਮਿਟਾਉਣਾ ਸਮਰੱਥ ਨਹੀਂ ਹੈ"

#: .\lifecycle.py:293
msgid "not provisioned by this deployment"
msgstr "ਇਸ ਡਿਪਲਾਇਮੈਂਟ ਵੱਲੋਂ ਪ੍ਰੋਵਿਜ਼ਨ ਨਹੀਂ ਕੀਤੀ ਗਈ"

#: .\lifecycle.py:294
