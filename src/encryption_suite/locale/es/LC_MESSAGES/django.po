#: .\admin.py:322
#, python-format
msgid ""
"Cannot schedule %(n)d key(s) (%(reasons)s). Destroying one makes its silo's "
"data permanently unreadable, and deleting would refuse it for the same "
"reason. Delete the silo first, or set "
"KEY_DELETION_CAN_RENDER_DATA_INACCESSIBLE to True in ENCRYPTION. %(uids)s"
msgstr ""
"No se pueden programar %(n)d clave(s) (%(reasons)s). Destruir una deja los "
"datos de su silo permanentemente ilegibles, y el borrado la rechazaría por "
"la misma razón. Elimine primero el silo, o establezca "
"KEY_DELETION_CAN_RENDER_DATA_INACCESSIBLE en True dentro de ENCRYPTION. "
"%(uids)s"

