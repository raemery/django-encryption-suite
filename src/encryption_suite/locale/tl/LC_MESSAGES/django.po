#: .\admin.py:322
#, python-format
msgid ""
"Cannot schedule %(n)d key(s) (%(reasons)s). Destroying one makes its silo's "
"data permanently unreadable, and deleting would refuse it for the same "
"reason. Delete the silo first, or set "
"KEY_DELETION_CAN_RENDER_DATA_INACCESSIBLE to True in ENCRYPTION. %(uids)s"
msgstr ""
"Hindi maiiskedyul ang %(n)d (na) susi (%(reasons)s). Ang pagsira sa isa ay "
"permanenteng nagpapabasa-imposible sa data ng silo nito, at tatanggihan din "
"ito ng pagtanggal sa parehong dahilan. Tanggalin muna ang silo, o itakda ang "
"KEY_DELETION_CAN_RENDER_DATA_INACCESSIBLE sa True sa ENCRYPTION. %(uids)s"

